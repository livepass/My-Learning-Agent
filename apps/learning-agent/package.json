{
  "name": "my-learning-agent",
  "version": "0.7.0",
  "description": "Personal learning agent built on PI SDK with three-layer memory system",
  "type": "module",
  "bin": {
    "my-learning-agent": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "server": "node dist/server.js",
    "web:dev": "npm --workspace my-learning-agent-web run dev",
    "web:build": "npm --workspace my-learning-agent-web run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@gotgenes/pi-permission-system": "^36.2.0",
    "@llamaindex/liteparse": "^1.3.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "pino": "^10.3.1",
    "pino-caller": "^4.0.0",
    "source-map-support": "^0.5.21",
    "typebox": "^1.3.7",
    "undici": "^7.19.1",
    "yaml": "^2.6.1"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "devDependencies": {
    "@types/pino": "^7.0.4"
  }
}
