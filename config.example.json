{
  "defaultProvider": "example",
  "defaultModel": "replace-with-your-model-id",
  "providers": {
    "example": {
      "baseUrl": "https://api.example.com/v1",
      "api": "openai-completions",
      "apiKey": "replace-me",
      "models": [
        {
          "id": "replace-with-your-model-id",
          "name": "Your model",
          "input": [
            "text"
          ],
          "contextWindow": 32768,
          "maxTokens": 4096
        }
      ]
    }
  },
  "memory": {
    "l1Enabled": true,
    "l2Enabled": true,
    "l3Enabled": true
  },
  "ui": {
    "theme": "light"
  }
}
